# OPENAI_API_KEY: Required for OpenAI Responses API calls.
# Keep this server-side only; never expose it in browser code or commit the real value.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# OPENAI_MODEL: Optional. Defaults to gpt-5.6-terra, selected for balanced quality and cost.
OPENAI_MODEL="gpt-5.6-terra"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
